# Non-secret runtime settings (committed). Secrets go in ../.env.
# Apply a change with `node scripts/setup.mjs` (or `docker compose up -d`, which recreates n8n when this file changes).

# AI provider for both calls:
#   ollama    — local gemma4:e4b through Ollama (free, offline; Ollama must be running on the host)
#   anthropic — Claude API, claude-opus-5-5 (store the key with `node scripts/set-anthropic-key.mjs`)
#   mock      — offline test stub: AI and Slack both go to `node eval/mock.mjs` on :8787
TRIAGE_AI_MODE=ollama

# Optional overrides (empty = default for the mode)
TRIAGE_AI_BASE_URL=
TRIAGE_CLASSIFY_MODEL=
TRIAGE_DRAFT_MODEL=

# Review rules
TRIAGE_CONFIDENCE_THRESHOLD=0.8
# Address the shared inbox receives mail on (mail from it is skipped as a self-loop)
TRIAGE_SUPPORT_ADDRESS=support@tidewell.example
# Message content is purged after this many days (category, confidence and reasons are kept)
TRIAGE_RETENTION_DAYS=30

TZ=Asia/Manila
GENERIC_TIMEZONE=Asia/Manila
